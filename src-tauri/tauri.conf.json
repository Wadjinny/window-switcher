{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Window Switcher",
  "version": "0.4.0",
  "identifier": "com.ilyaswadjinny.window-switcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "switcher",
        "title": "Window Switcher",
        "width": 980,
        "height": 205,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "center": true,
        "focus": false,
        "focusable": false,
        "closable": false,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
