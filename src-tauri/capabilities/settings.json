{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The Settings window: reading and changing settings, and recording hotkeys",
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-settings",
    "allow-set-setting",
    "allow-reset-hotkeys",
    "allow-set-hotkey-recording"
  ]
}
